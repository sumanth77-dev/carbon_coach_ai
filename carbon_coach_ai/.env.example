# Carbon Coach AI - Environment Configuration Example
# Copy this file to .env and insert your Gemini API Key

# Gemini API Credentials (Required)
GOOGLE_API_KEY=your_actual_gemini_api_key_here

# Model Selection (defaults to gemini-3.1-flash-lite or gemini-2.5-flash)
ECOMATE_MODEL=gemini-3.1-flash-lite

# Server Configuration (Optional)
HOST=0.0.0.0
PORT=8080
